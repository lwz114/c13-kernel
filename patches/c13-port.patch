+# --- Clocks / misc SoC ---
+CONFIG_MSM_MMCC_8996=y
+CONFIG_QCOM_QFPROM=y
+CONFIG_QCOM_CPR=y
+CONFIG_QCOM_TSENS=y
+CONFIG_QCOM_SMD_RPM=y
