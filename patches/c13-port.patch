+CONFIG_USB_DWC3=y
+CONFIG_PHY_QCOM_QUSB2=y
+CONFIG_TYPEC=y
+CONFIG_EXTCON_USBC_TUSB320=y
+
+# --- WLAN / BT (QCA6174) ---
+CONFIG_ATH10K=y
+CONFIG_ATH10K_PCI=y
+CONFIG_BT_HCIUART=y
+CONFIG_BT_HCIUART_QCA=y
+
+# --- PCIe ---
+CONFIG_PCIE_QCOM=y
+CONFIG_PHY_QCOM_PCIE2=y
+
+# --- Audio (WCD9335 on SLIMbus, needs ADSP firmware) ---
+CONFIG_SND=y
+CONFIG_SND_SOC=y
+CONFIG_SND_SOC_QCOM=y
+CONFIG_SND_SOC_MSM8996=m
+CONFIG_SND_SOC_QDSP6=m
+CONFIG_SND_SOC_WCD9335=m
+CONFIG_SLIMBUS=y
+CONFIG_SLIM_QCOM_CTRL=y
+CONFIG_SLIM_QCOM_NGD_CTRL=y
+CONFIG_QCOM_APR=y
+
+# --- Sensors / Haptics / PMIC bits ---
+CONFIG_ALS31300=m
+CONFIG_INPUT_QCOM_SPMI_HAPTICS=y
+CONFIG_QCOM_SPMI_TEMP_ALARM=y
+CONFIG_QCOM_SPMI_VADC=y
+CONFIG_QCOM_SPMI_ADC5=y
+
+# --- Misc ---
+CONFIG_RAMOOPS=y
+CONFIG_CMA_SIZE_MBYTES=128
+CONFIG_ARM_QCOM_CPUFREQ_HW=y
+CONFIG_ARM_QCOM_CPUFREQ_NVMEM=y
+
+# --- Boot console via simplefb (no UART on this device) ---
+CONFIG_FB_SIMPLE=y
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
+
+# --- Android userspace compatibility (optional, e.g. TWRP ramdisk) ---
+CONFIG_ANDROID_BINDER_IPC=y
+CONFIG_ANDROID_BINDERFS=y
