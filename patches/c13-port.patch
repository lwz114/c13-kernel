+# Readboy C13 (MSM8996) kernel configuration fragment
+#
+# Applied on top of the arm64 defconfig via merge_config.sh to produce
+# arch/arm64/configs/msm8996_readboy_c13_defconfig (see build.sh).
+
+# --- Display / DRM ---
+CONFIG_DRM=y
+CONFIG_BACKLIGHT_CLASS_DEVICE=y
+CONFIG_DRM_KMS_HELPER=y
