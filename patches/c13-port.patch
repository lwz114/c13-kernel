+	vddio-supply = <&vreg_l14a_1p8>;
+
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&mdss_dsi_active &mdss_te_default>;
+	pinctrl-1 = <&mdss_dsi_sleep>;
+
+	panel@0 {
+		compatible = "readboy,lmi-bn1051";
+		reg = <0>;
+
+		vddio-supply = <&vreg_l14a_1p8>;
+		lab-supply = <&lab>;
+		ibb-supply = <&ibb>;
+
+		reset-gpios = <&tlmm 8 GPIO_ACTIVE_HIGH>;
+
+		backlight = <&pmi8994_wled>;
+	};
+};
+
+&mdss_dsi0_out {
+	status = "okay";
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	status = "okay";
+	vcca-supply = <&vreg_l28a_0p925>;
+};
+
+/* QCA6174 WLAN lives on PCIe0 (enumerated at runtime by ath10k) */
+&pcie0 {
+	status = "okay";
+	vddpe-supply = <&rome_vreg>;
+};
+
+&pcie_phy {
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+};
+
+&mmcc {
+	vdd-gfx-supply = <&vdd_gfx>;
+};
+
+&mss_pil {
+	status = "okay";
+	pll-supply = <&vreg_l12a_1p8>;
+};
+
+&slpi_pil {
+	status = "okay";
+	px-supply = <&vreg_lvs2a_1p8>;
+};
+
+&venus {
+	status = "okay";
+};
+
+/* WCD9335 (tasha) audio codec on SLIMbus - needs ADSP firmware */
+&slim_msm {
+	status = "okay";
+
+	slim@1 {
+		reg = <1>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+
+		tasha_ifd: tas-ifd@0,0 {
+			compatible = "slim217,1a0";
+			reg = <0 0>;
+		};
+
+		wcd9335: codec@1,0 {
+			compatible = "slim217,1a0";
+			reg = <1 0>;
+
+			clock-names = "mclk", "slimbus";
+			clocks = <&div1_mclk>,
+				 <&rpmcc RPM_SMD_BB_CLK1>;
+			interrupt-parent = <&tlmm>;
+			interrupts = <54 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "intr1";
+			interrupt-controller;
+			#interrupt-cells = <1>;
+
+			pinctrl-0 = <&cdc_reset_active &wcd_intr_default>;
+			pinctrl-names = "default";
+
+			reset-gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;
+			slim-ifc-dev = <&tasha_ifd>;
+
+			#sound-dai-cells = <1>;
+
+			vdd-buck-supply = <&vreg_s4a_1p8>;
+			vdd-buck-sido-supply = <&vreg_s4a_1p8>;
+			vdd-rx-supply = <&vreg_s4a_1p8>;
+			vdd-tx-supply = <&vreg_s4a_1p8>;
+			vdd-vbat-supply = <&vph_pwr>;
+			vdd-micbias-supply = <&vph_pwr_bbyp>;
+			vdd-io-supply = <&vreg_s4a_1p8>;
+		};
+	};
+};
+
+&pm8994_gpios {
+	audio_mclk: audio-mclk-state {
+		pins = "gpio15";
+		function = "func2";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
+
+/*
+ * The MDP SMMU context banks are used by the bootloader (ABL) for the
+ * splash screen (and possibly by TZ). Do not reset/repurpose them on
+ * probe, otherwise the kernel crashes and reboots as soon as the MDP
+ * SMMU is initialized (same issue as on the Xiaomi Mi Note 2 - see
+ * postmarketOS wiki). qcom,no-smr-check avoids touching the stream
+ * match registers as well.
+ */
+&mdp_smmu {
+	qcom,skip-init;
+	qcom,no-smr-check;
+};
