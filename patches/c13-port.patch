+	.enable = readboy_c13_panel_enable,
+	.get_modes = readboy_c13_panel_get_modes,
+};
+
+static int readboy_c13_panel_get_modes(struct drm_panel *panel,
+				       struct drm_connector *connector)
+{
+	struct readboy_c13_panel *ctx = to_readboy_c13_panel(panel);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, ctx->desc->mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+
+	connector->display_info.width_mm = ctx->desc->mode->width_mm;
+	connector->display_info.height_mm = ctx->desc->mode->height_mm;
+
+	return 1;
+}
+
+static int readboy_c13_panel_probe(struct mipi_dsi_device *dsi)
+{
+	struct readboy_c13_panel *ctx;
+	const struct readboy_c13_panel_desc *desc;
+	int ret;
+
+	ctx = devm_kzalloc(&dsi->dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	desc = of_device_get_match_data(&dsi->dev);
+	if (!desc)
+		return -ENODEV;
+
+	mipi_dsi_set_drvdata(dsi, ctx);
+	ctx->dsi = dsi;
+	ctx->desc = desc;
+
+	ctx->vddio = devm_regulator_get(&dsi->dev, "vddio");
+	if (IS_ERR(ctx->vddio))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->vddio),
+				     "failed to get vddio regulator\n");
+
+	ctx->lab = devm_regulator_get(&dsi->dev, "lab");
+	if (IS_ERR(ctx->lab))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->lab),
+				     "failed to get lab regulator\n");
+
+	ctx->ibb = devm_regulator_get(&dsi->dev, "ibb");
+	if (IS_ERR(ctx->ibb))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->ibb),
+				     "failed to get ibb regulator\n");
+
+	ctx->reset = devm_gpiod_get(&dsi->dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(&dsi->dev, PTR_ERR(ctx->reset),
+				     "failed to get reset GPIO\n");
+
+	drm_panel_init(&ctx->panel, &dsi->dev, &readboy_c13_panel_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+	ctx->panel.prepare_prev_first = true;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(&dsi->dev, ret,
+				     "failed to get backlight device\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void readboy_c13_panel_remove(struct mipi_dsi_device *dsi)
+{
+	struct readboy_c13_panel *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
