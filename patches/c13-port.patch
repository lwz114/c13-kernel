+			lab: lab {
+				interrupts = <0x2 0xde 0x1 IRQ_TYPE_EDGE_RISING>,
+					     <0x2 0xde 0x0 IRQ_TYPE_LEVEL_LOW>;
+				interrupt-names = "sc-err", "ocp";
+			};
+		};
+	};
