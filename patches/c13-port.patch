+# --- Regulators / PMIC ---
+CONFIG_REGULATOR_QCOM_LABIBB=y
+CONFIG_QCOM_SPMI_REGULATOR=y
+CONFIG_QCOM_RPMCC=y
+CONFIG_QCOM_SPMI_PMIC=y
+CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
