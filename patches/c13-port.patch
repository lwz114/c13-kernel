+	};
+};
+
+/*
+ * Touch panel, Himax "HX common" variant on BLSP1 QUP5 SPI
+ * (CS0 = GPIO 83, IRQ = GPIO 125, reset = GPIO 89).
+ * Driver is not yet in mainline (vendor "hxcommon" backport needed).
+ */
+&blsp1_spi5 {
+	status = "okay";
+	cs-gpios = <&tlmm 83 GPIO_ACTIVE_HIGH>;
+
+	himax@0 {
+		compatible = "himax,hxcommon";
+		reg = <0>;
+		spi-max-frequency = <9600000>;
+		spi-cpha;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <125 IRQ_TYPE_EDGE_RISING>;
+		himax,irq-gpio = <&tlmm 125 GPIO_ACTIVE_HIGH>;
+		himax,rst-gpio = <&tlmm 89 GPIO_ACTIVE_HIGH>;
+		himax,panel-coords = <0 1200 0 1920>;
+		himax,display-coords = <0 1200 0 1920>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&ts_irq_default &ts_rst_default>;
+	};
+};
+
+/* Touch panel, FocalTech FTS variant on BLSP2 QUP6 I2C */
+&blsp2_i2c6 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	focaltech@38 {
+		compatible = "focaltech,fts";
+		reg = <0x38>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <125 IRQ_TYPE_EDGE_FALLING>;
+		vdd-supply = <&vreg_l17a_2p8>;
+		focaltech,reset-gpio = <&tlmm 89 GPIO_ACTIVE_HIGH>;
+		focaltech,irq-gpio = <&tlmm 125 GPIO_ACTIVE_HIGH>;
+		focaltech,max-touch-number = <10>;
+		focaltech,display-coords = <0 0 1200 1920>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&ts_irq_default &ts_rst_default>;
+	};
+};
+
+/*
+ * Sensors on BLSP2 QUP3 I2C:
+ *  - Allegro ALS31300 3D hall sensor (mainline: CONFIG_ALS31300)
+ *  - AKM AK09970 magnetometer (no mainline driver yet, node kept for docs)
+ */
+&blsp2_i2c3 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	als31300@60 {
+		compatible = "allegro,als31300";
+		reg = <0x60>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <117 IRQ_TYPE_LEVEL_HIGH>;
+	};
+
+	ak09970d@11 {
+		compatible = "akm,ak09970d";
+		reg = <0x11>;
+		pwr-en-gpio = <&tlmm 6 GPIO_ACTIVE_HIGH>;
+		reset-gpio = <&tlmm 73 GPIO_ACTIVE_HIGH>;
+		irq-gpio = <&tlmm 117 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+/* USB Type-C CC detection (TUSB320). USB2-only device. */
+&blsp2_i2c1 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	tusb320: tusb320@61 {
+		compatible = "ti,tusb320";
+		reg = <0x61>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <117 IRQ_TYPE_EDGE_FALLING>;
+		vbus-supply = <&chg_otg>;
+	};
+};
+
+/* Board EEPROM on BLSP1 QUP6 I2C */
+&blsp1_i2c6 {
+	status = "okay";
+	clock-frequency = <400000>;
+
+	eeprom@51 {
+		compatible = "atmel,24c32";
+		reg = <0x51>;
+		pagesize = <32>;
+	};
