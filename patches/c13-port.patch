+static int readboy_c13_panel_prepare(struct drm_panel *panel)
+{
+	struct readboy_c13_panel *ctx = to_readboy_c13_panel(panel);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	int ret;
+
+	ret = regulator_enable(ctx->vddio);
+	if (ret)
+		return ret;
+
+	ret = regulator_enable(ctx->lab);
+	if (ret)
+		goto err_lab;
+
+	ret = regulator_enable(ctx->ibb);
+	if (ret)
+		goto err_ibb;
+
+	/* Reset sequence from the stock device tree: 1 10ms 0 10ms 1 50ms */
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	msleep(10);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(10);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	msleep(50);
+
+	ret = readboy_c13_replay(dsi, ctx->desc->on_cmds.data,
+				 ctx->desc->on_cmds.len);
+	if (ret)
+		goto err_cmds;
+
+	return 0;
+
+err_cmds:
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	regulator_disable(ctx->ibb);
+err_ibb:
+	regulator_disable(ctx->lab);
+err_lab:
+	regulator_disable(ctx->vddio);
+	return ret;
+}
+
+static int readboy_c13_panel_unprepare(struct drm_panel *panel)
+{
+	struct readboy_c13_panel *ctx = to_readboy_c13_panel(panel);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	int ret;
+
+	ret = readboy_c13_replay(dsi, ctx->desc->off_cmds.data,
+				 ctx->desc->off_cmds.len);
+	if (ret)
+		dev_warn(&dsi->dev, "off command sequence failed: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	msleep(50);
+
+	regulator_disable(ctx->ibb);
+	regulator_disable(ctx->lab);
+	regulator_disable(ctx->vddio);
+
+	return 0;
+}
+
+static int readboy_c13_panel_enable(struct drm_panel *panel)
+{
+	struct readboy_c13_panel *ctx = to_readboy_c13_panel(panel);
+
+	return mipi_dsi_dcs_set_display_on(ctx->dsi);
+}
+
+static int readboy_c13_panel_disable(struct drm_panel *panel)
+{
+	struct readboy_c13_panel *ctx = to_readboy_c13_panel(panel);
+
+	return mipi_dsi_dcs_set_display_off(ctx->dsi);
+}
