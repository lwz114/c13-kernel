diff --git a/arch/arm64/boot/dts/qcom/msm8996-readboy-c13-minimal.dts b/arch/arm64/boot/dts/qcom/msm8996-readboy-c13-minimal.dts
new file mode 100644
index 000000000..2863d41a1
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8996-readboy-c13-minimal.dts
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Minimal Readboy C13 board file - bring-up only (serial console) */
+/dts-v1/;
+
+#include "msm8996.dtsi"
+#include "pm8994.dtsi"
+#include "pmi8994.dtsi"
+#include "pmi8996.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+
+/ {
+	model = "Readboy C13";
+	compatible = "readboy,msm8996-c13", "qcom,msm8996";
+	chassis-type = "tablet";
+
+	qcom,msm-id = <246 0x30001>;
+	qcom,board-id = <8 0>;
+	qcom,pmic-id = <0x20009 0x10013 0 0>;
+
+	aliases {
+		serial1 = &blsp2_uart2;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
+
+&rpm_requests {
+	regulators-0 {
+		compatible = "qcom,rpm-pm8994-regulators";
+		vreg_s3a_1p3: s3 {
+			regulator-name = "vreg_s3a_1p3";
+			regulator-min-microvolt = <1300000>;
+			regulator-max-microvolt = <1300000>;
+		};
+		vreg_s4a_1p8: s4 {
+			regulator-name = "vreg_s4a_1p8";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+	};
+	regulators-1 {
+		compatible = "qcom,rpm-pmi8994-regulators";
+		vph_pwr_bbyp: boost-bypass {
+			regulator-name = "vph_pwr_bbyp";
+			regulator-min-microvolt = <3150000>;
+			regulator-max-microvolt = <3600000>;
+		};
+	};
+};
+
+&blsp2_uart2 {
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/qcom/msm8996-readboy-c13.dts b/arch/arm64/boot/dts/qcom/msm8996-readboy-c13.dts
new file mode 100644
index 000000000..948c3771b
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8996-readboy-c13.dts
@@ -0,0 +1,881 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Readboy C13 (读书郎 C13) - Snapdragon 820 / MSM8996 education tablet
+ *
+ * 10.1" 1200x1920 DSI LCD (Ilitek ILI9881D / Himax panel variants),
+ * ~8000 mAh battery (HTT/ATL), QCA6174 WLAN+BT combo,
+ * WCD9335 (tasha) audio codec + dual AW smart amps, dual speakers,
+ * USB Type-C (TUSB320) USB2, eMMC + microSD, 3 cameras.
+ *
+ * Board wiring was derived from the stock boot.img device tree
+ * (Android 7.1.2, kernel 3.18.31-perf, readboy/msm8996).
+ *
+ * Status of mainline support (see also Documentation/arm64/msm8996-c13.rst):
+ *  - Boot / console / eMMC / SD / USB2 / charging / fuel gauge: expected OK
+ *  - Display: panel driver present (readboy,lmi-bn1051 / readboy,rk-bn1051),
+ *    needs on-device bring-up (panel variant selection + backlight tuning)
+ *  - BT: QCA6174 via qca6174-bt (needs QCA6174 BT firmware)
+ *  - WLAN: PCIe RC enabled; QCA6174 needs ath10k firmware + enumeration test
+ *  - Audio: WCD9335 wired; needs ADSP firmware (not present on stock Android
+ *    without /vendor firmware) - smart amps (AW8898/AW8811) not mainline
+ *  - Touch: Himax HX common (SPI) / FocalTech FTS (I2C) nodes present,
+ *    drivers not yet in mainline (vendor backport required)
+ *  - Cameras / DSPG voice DSP / secondary charger: not yet in mainline
+ */
+
+/dts-v1/;
+
+#include "msm8996.dtsi"
+#include "pm8994.dtsi"
+#include "pmi8994.dtsi"
+#include "pmi8996.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+#include <dt-bindings/sound/qcom,wcd9335.h>
+
+/ {
+	model = "Readboy C13";
+	compatible = "readboy,msm8996-c13", "qcom,msm8996";
+	chassis-type = "tablet";
+
+	/* Bootloader (ABL) hardware validation - values from the stock DTB */
+	qcom,msm-id = <246 0x30001>;	/* MSM8996 v3.1 */
+	qcom,board-id = <8 0>;
+	qcom,pmic-id = <0x20009 0x10013 0 0>;	/* PM8996 + PMI8996 */
+
+	aliases {
+		serial0 = &blsp1_uart2;		/* QCA6174 Bluetooth */
+		serial1 = &blsp2_uart2;		/* console (ttyHSL0 on stock) */
+		mmc0 = &sdhc1;			/* eMMC */
+		mmc1 = &sdhc2;			/* microSD */
+		i2c6 = &blsp1_i2c6;
+		i2c7 = &blsp2_i2c1;
+		i2c9 = &blsp2_i2c3;
+		i2c12 = &blsp2_i2c6;
+		spi5 = &blsp1_spi5;
+	};
+
+	chosen {
+		stdout-path = "serial1:115200n8";
+
+		/*
+		 * Simple framebuffer console: the bootloader (ABL) keeps the
+		 * 1200x1920 splash running in video mode, so the kernel can draw
+		 * a fbcon console over it without any display driver. This is
+		 * the primary way to get kernel logs on this device (no UART
+		 * header). Address/size match the stock cont_splash_mem.
+		 */
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		framebuffer0: framebuffer@83401000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0x83401000 0x0 0x697800>; /* 1200*1920*3 */
+			width = <1200>;
+			height = <1920>;
+			stride = <3600>; /* 1200*3 */
+			format = "r8g8b8";
+		};
+	};
+
+	battery: battery {
+		compatible = "simple-battery";
+
+		/*
+		 * Stock fuel gauge profiles: "HTT_8000mah" (batt-id 120 kOhm)
+		 * and "ATL_7600mah". 4.35 V max charge voltage, 3 A fast charge.
+		 */
+		charge-full-design-microamp-hours = <7200000>;
+		voltage-min-design-microvolt = <3400000>;
+		voltage-max-design-microvolt = <4350000>;
+		constant-charge-current-max-microamp = <3000000>;
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	/*
+	 * WLAN enable (the stock tree calls it "wlan-bootstrap-gpio",
+	 * TLMM GPIO 46) and the QCA6174 VDD_WLAN rail (rome_vreg, 1.8 V).
+	 */
+	wlan_en: wlan-en-regulator {
+		compatible = "regulator-fixed";
+		pinctrl-names = "default";
+		pinctrl-0 = <&wlan_en_state>;
+		regulator-name = "wlan-en-regulator";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		gpio = <&tlmm 46 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		startup-delay-us = <70000>;
+	};
+
+	rome_vreg: rome-vreg {
+		compatible = "regulator-fixed";
+		regulator-name = "rome_vreg";
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+		startup-delay-us = <4000>;
+		regulator-always-on;
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		volume-up {
+			label = "Volume Up";
+			gpios = <&pm8994_gpios 2 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_KEY>;
+			linux,code = <KEY_VOLUMEUP>;
+			gpio-key,wakeup;
+			debounce-interval = <15>;
+		};
+	};
+
+	divclk4: divclk4 {
+		compatible = "fixed-clock";
+		pinctrl-names = "default";
+		pinctrl-0 = <&divclk4_pin_a>;
+		#clock-cells = <0>;
