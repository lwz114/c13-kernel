index 000000000..126a48980
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-readboy-c13.c
@@ -0,0 +1,733 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Readboy C13 (读书郎C13) 10.1" 1200x1920 DSI LCD panel driver
+ *
+ * The C13 ships with one of two DSI video-mode panels:
+ *   - lmi_bn_1051: Ilitek ILI9881D-class controller
+ *   - rk_bn_1051:  Himax-class controller
+ * Both are 1200x1920@60Hz, 4-lane, burst mode, powered by vddio (1.8V)
+ * plus the PMI8996 LAB/IBB display bias regulators, with a PMI8996 WLED
+ * backlight. The on/off command sequences below were extracted verbatim
+ * from the stock boot.img device tree (Android 7.1.2 / kernel 3.18) of
+ * the device, so they are the exact sequences the vendor kernel uses.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+#include <video/mipi_display.h>
+
+struct readboy_c13_cmd_blob {
+	const u8 *data;
+	size_t len;
+};
+
+struct readboy_c13_panel_desc {
+	const struct readboy_c13_cmd_blob on_cmds;
+	const struct readboy_c13_cmd_blob off_cmds;
+	const struct drm_display_mode *mode;
+	unsigned long mode_flags;
+};
+
+struct readboy_c13_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	const struct readboy_c13_panel_desc *desc;
+
+	struct regulator *vddio;
+	struct regulator *lab;
+	struct regulator *ibb;
+	struct gpio_desc *reset;
+};
+
+static inline struct readboy_c13_panel *to_readboy_c13_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct readboy_c13_panel, panel);
+}
+
+/*
+ * The stock command blobs use the Qualcomm DSI packet wire format:
+ *   type, last, vc, ack, wait_ms_hi, wait_ms_lo, payload_len, payload...
+ * where payload starts with a length byte followed by the DCS payload.
+ */
+static int readboy_c13_replay(struct mipi_dsi_device *dsi,
+			      const u8 *blob, size_t len)
+{
+	size_t i = 0;
+	int ret;
+
+	while (i + 7 <= len) {
+		u8 type = blob[i];
+		u16 wait_ms = (blob[i + 4] << 8) | blob[i + 5];
+		u8 plen = blob[i + 6];
+		const u8 *p = &blob[i + 7];
+
+		if (i + 7 + plen > len) {
+			dev_err(&dsi->dev, "malformed blob at offset %zu\n", i);
+			return -EINVAL;
+		}
+
+		/* payload[0] is the DCS command byte */
+		switch (type) {
+		case 0x05: /* DCS short write, 0 parameters */
+			ret = mipi_dsi_dcs_write(dsi, p[0], NULL, 0);
+			break;
+		case 0x15: /* DCS short write, 1 parameter */
+			ret = mipi_dsi_dcs_write(dsi, p[0], &p[1], 1);
+			break;
+		case 0x39: /* DCS long write */
+			ret = mipi_dsi_dcs_write(dsi, p[0], &p[1], plen - 1);
+			break;
+		default:
+			dev_warn(&dsi->dev, "skipping unknown cmd type 0x%02x\n",
+				 type);
+			ret = 0;
+			break;
+		}
+
+		if (ret < 0) {
+			dev_err(&dsi->dev, "sending DCS cmd 0x%02x failed: %d\n",
+				p[0], ret);
+			return ret;
+		}
+
+		if (wait_ms)
+			msleep(wait_ms);
+
+		i += 7 + plen;
+	}
+
+	return 0;
+}
+
+/* lmi_bn_1051 (Ilitek ILI9881D) on-command sequence */
+static const u8 lmi_bn_1051_on[] = {
+	0x39, 0x01, 0x00, 0x00, 0x00, 0x00, 0x04, 0xb9, 0x83, 0x10, 0x2e,
