+		/* Stock: bt-reset-gpio = PMIC GPIO 19 */
+		enable-gpios = <&pm8994_gpios 19 GPIO_ACTIVE_HIGH>;
+		clocks = <&divclk4>;
+	};
+};
+
+&pm8994_gpios {
+	divclk4_pin_a: divclk4-pin-active {
